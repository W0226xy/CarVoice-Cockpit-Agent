# Agent server
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
LOG_LEVEL=INFO

# Required real LLM configuration. Copy this file to .env for local development.
# Do not commit real credentials. A trailing /v1 is accepted and normalized.
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://your-provider.example
OPENAI_API_KEY=replace_with_local_secret
OPENAI_MODEL=your-model-id

# Optional Tavily remote MCP search. Disabled unless both enabled and keyed.
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_SEARCH_TIMEOUT_SECONDS=15
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_SNIPPET_CHARS=800
TAVILY_MAX_CONTEXT_CHARS=6000

# RAG phase two. Memory mode is self-contained and remains the default.
RAG_ENABLED=false
RAG_STORAGE=memory
DATABASE_URL=jdbc:postgresql://localhost:5432/carvoice
DATABASE_USER=carvoice
DATABASE_PASSWORD=replace_with_local_password
EMBEDDING_BASE_URL=https://your-embedding-provider.example
EMBEDDING_API_KEY=replace_with_local_secret
EMBEDDING_MODEL=your-embedding-model-id
EMBEDDING_DIMENSION=1536
KNOWLEDGE_IMPORT_ENABLED=false
KNOWLEDGE_MAX_FILE_SIZE_MB=20
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.5
